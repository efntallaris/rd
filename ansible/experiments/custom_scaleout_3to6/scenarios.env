# ---------------------------------------------------------------------------
# scenarios.env for the 3 -> 6 scale-out (custom_scaleout_3to6). Sourced by
# crash/run_crash_scenario.sh (SCENARIOS_ENV) with $SCENARIO set.
# Sets: LABEL ARM_HOST ARM_LOG ARM_MARKER ARM_COUNT TARGET_HOST PIDFILE
#       [PIDFILE_EXTRA] [TARGET_HOST2 PIDFILE2]
#
# Topology (topology.yml): three donor -> recipient pairs
#   A  sg1 redis0:8000 (followers redis1,redis2) -> sg4 redis3:8000 (redis4,redis5)
#   B  sg2 redis1:8001 (followers redis2,redis0) -> sg5 redis4:8001 (redis5,redis3)
#   C  sg3 redis2:8002 (followers redis0,redis1) -> sg6 redis5:8002 (redis3,redis4)
# Each donor sends 2730 slots in ROUNDS rounds (default 6 x 455, see env.sh), a
# round in 2 chunks (342 + 113), so its recipient leader logs 12 DONE-SLOTS-CHUNK.
#
# S1-S4 and S8 are the single-recipient scenarios (crash/scenarios.env) applied
# to pair A, with the same markers. S6, S7 and S9 exist only here: a host now
# runs three groups, and the pairs migrate at the same time.
#
# C1-C16: the evaluation's crash matrix (experiments/2026-10-20_scaleout_3to6_crash_recovery/
# README.md), all on pair A, in its first round unless noted. C2, C8, C9 and C10 are S2, S4,
# S3 and S5. The others use fault_steps.sh (STEPS) and, where the window is only a few ms
# wide, a one-shot pause in the server code (HOOKS "host:name[:ms]", rdmaTestHook).
# Pair A: donor sg1 leader redis0; recipient sg4 leader redis3, chain F1 redis4 -> F2 redis5.
# ---------------------------------------------------------------------------
ARM_HOST="redis3"
ARM_LOG="/tmp/redis_logs/redis3_sg4.log"
PIDFILE_EXTRA=""
TARGET_HOST2=""; PIDFILE2=""

case "$SCENARIO" in
  # ---- C1-C16 ---------------------------------------------------------------
  C1)  # donor leader, after TXN_START (START) committed, before the session open (prepare)
    LABEL="C1-donor-leader-before-prepare"; HOOKS="redis0:before_open"
    STEPS="arm redis0 sg1 'TEST HOOK before_open'; kill redis0 sg1" ;;
  C2)  # donor leader during the RDMA writes (= S2)
    LABEL="C2-donor-leader-during-transfer"
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="state=TRANSFER"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid" ;;
  C3)  # donor leader after the recipient reported the range durable, before TXN_DONE (DONE)
    LABEL="C3-donor-leader-before-done"; HOOKS="redis0:before_txn_done"
    STEPS="arm redis0 sg1 'TEST HOOK before_txn_done'; kill redis0 sg1" ;;
  C4)  # recipient leader, session-open request appended but not committed (pause: main thread)
    LABEL="C4-recipient-leader-before-txn-start"; HOOKS="redis3:before_recp_open"
    STEPS="arm redis3 sg4 'TEST HOOK before_recp_open'; kill redis3 sg4" ;;
  C5)  # recipient leader with the round landed on it only: forwarding held 3 s, kill after
       # 0.6 s (the copy takes ~0.5 s). (S1 kills at the 4th chunk, when the pipelined
       # forward has already sent the first blocks to F1.)
    LABEL="C5-recipient-leader-data-on-leader-only"; HOOKS="redis3:before_forward:3000"
    STEPS="arm redis3 sg4 'TEST HOOK before_forward'; sleep 0.6; kill redis3 sg4" ;;
  C6)  # recipient leader with the round on F1 but not F2, before RECP_DURABLE; F2, which lacks
       # it, is elected and must fetch it from F1. F1 holds its forward to F2 for 6 s; its
       # election timeout is raised to 2 s first (a node with a longer timeout neither starts
       # an election nor grants a pre-vote while it still counts the old leader alive), so F2
       # wins; it is set back to the run's 500 ms once F2 leads.
    LABEL="C6-recipient-leader-data-on-follower"
    HOOKS="redis3:before_recp_durable:3000 redis4:follower_forward:6000"
    STEPS="arm redis3 sg4 'TEST HOOK before_recp_durable'; cmd redis4 sg4 CONFIG SET raft.election-timeout 2000; kill redis3 sg4; armany 'Node is now a leader' 1 redis4:sg4 redis5:sg4; cmd redis4 sg4 CONFIG SET raft.election-timeout 500" ;;
  C17) # as C6, but the follower that holds the round (F1) is elected: it applies the round it
       # held, unapplied, as a follower instead of reporting the range missing (F2's election
       # timeout raised instead)
    LABEL="C17-recipient-leader-holder-elected"
    HOOKS="redis3:before_recp_durable:3000 redis4:follower_forward:6000"
    STEPS="arm redis3 sg4 'TEST HOOK before_recp_durable'; cmd redis5 sg4 CONFIG SET raft.election-timeout 2000; kill redis3 sg4; armany 'Node is now a leader' 1 redis4:sg4 redis5:sg4; cmd redis5 sg4 CONFIG SET raft.election-timeout 500" ;;
  C7)  # recipient leader after RECP_DURABLE committed, before the donor can see "done"
    LABEL="C7-recipient-leader-after-durable"; HOOKS="redis3:after_recp_durable"
    STEPS="arm redis3 sg4 'TEST HOOK after_recp_durable'; kill redis3 sg4" ;;
  C8)  # recipient follower (F1) as the forward starts (= S4)
    LABEL="C8-recipient-follower"
    ARM_MARKER="spawned pipelined forwarder"; ARM_COUNT=1
    TARGET_HOST="redis4"; PIDFILE="/tmp/redis_redis4_sg4.pid" ;;
  C9)  # donor follower, control (= S3)
    LABEL="C9-donor-follower"
    ARM_MARKER="DONE-SLOTS-CHUNK"; ARM_COUNT=1
    TARGET_HOST="redis1"; PIDFILE="/tmp/redis_redis1_sg1.pid" ;;
  C10) # both leaders of pair A at the same instant, during the transfer (= S5)
    LABEL="C10-both-leaders"
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="state=TRANSFER"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid"
    TARGET_HOST2="redis3"; PIDFILE2="/tmp/redis_redis3_sg4.pid" ;;
  C11) # recipient leader, then the new leader as soon as it is elected (during its own
       # recovery). The first one is restarted afterwards: without it sg4 has no majority.
    LABEL="C11-recipient-leader-twice"
    STEPS="arm redis3 sg4 DONE-SLOTS-CHUNK 4; kill redis3 sg4; armany 'Node is now a leader' 1 redis4:sg4 redis5:sg4; kill @; restart redis3 sg4" ;;
  C12) # recipient replicas holding round 1, one after another, each restarted; the next is
       # killed only once the restarted one has rejoined: it holds as many keys as the leader
       # again (a fixed wait, or the leader's per-round "every live follower holds the batch",
       # killed F2 while rounds were still on the leader alone)
    LABEL="C12-recipient-replicas-in-turn"
    STEPS="arm redis3 sg4 'MGN_RECP_DURABLE applied'; kill redis4 sg4; restart redis4 sg4; sleep 3; waitsync redis3 sg4 redis4 sg4 60; kill redis5 sg4; restart redis5 sg4; sleep 3; waitsync redis3 sg4 redis5 sg4 60" ;;
  C13) # recipient leader killed and restarted on the same node, during its transfer
    LABEL="C13-recipient-leader-restart"
    STEPS="arm redis3 sg4 DONE-SLOTS-CHUNK 4; kill redis3 sg4; restart redis3 sg4" ;;
  C14) # slow recipient follower: F1 frozen (SIGSTOP) for 3 s as the forward starts
    LABEL="C14-slow-recipient-follower"
    STEPS="arm redis3 sg4 'spawned pipelined forwarder'; stop redis4 sg4 3; sleep 4" ;;
  C15) # partition between the two leaders' hosts for 5 s during the transfer (TCP/IP only:
       # the NICs are RoCE, existing RDMA queue pairs keep working)
    LABEL="C15-partition-leaders"
    STEPS="arm redis0 sg1 'state=TRANSFER'; partition redis0 redis3 5; sleep 6" ;;
  C16) # very short timeouts, no fault: election 150 ms, raft request 20 ms, peer probe 50 ms
    LABEL="C16-short-timeouts"
    SCEN_EXTRA_ARGS="-e raft_election_timeout=150 -e raft_request_timeout=20 -e rdma_peer_probe_ms=50"
    STEPS="sleep 0" ;;
  # ---- S1-S9 -----------------------------------------------------------------
  S1)  # recipient LEADER crash, pair A: kill sg4's leader mid-transfer (4th of 12 chunks, round 2)
    LABEL="S1-recipient-leader"
    ARM_MARKER="DONE-SLOTS-CHUNK"; ARM_COUNT=4
    TARGET_HOST="redis3"; PIDFILE="/tmp/redis_redis3_sg4.pid"
    ;;
  S2)  # donor LEADER crash, pair A: kill sg1's leader while it is transferring
    LABEL="S2-donor-leader"
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="state=TRANSFER"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid"
    ;;
  S8)  # donor LEADER crash between registration and DONE-SLOTS-INIT, pair A: kill sg1's
         # leader as it logs FLIPPING, i.e. after the recipient accepted its block registration
         # but before the transfer is announced. The registration then never gets a batch on the
         # recipient (2026-10-21: its backpatch hold was never released and SCAN/DBSIZE on the
         # sg4 leader missed every key merged afterwards; fixed by releasing it at re-registration).
    # The window is ~1 ms: the one-shot hook pauses the donor 1.5 s there.
    LABEL="S8-donor-leader-after-register"; HOOKS="redis0:before_init"
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="TEST HOOK before_init"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid"
    ;;
  S3)  # donor FOLLOWER crash, pair A: kill sg1's follower on redis1 (majority holds)
    LABEL="S3-donor-follower"
    ARM_MARKER="DONE-SLOTS-CHUNK"; ARM_COUNT=1
    TARGET_HOST="redis1"; PIDFILE="/tmp/redis_redis1_sg1.pid"
    ;;
  S4)  # recipient FOLLOWER crash, pair A: kill chain follower redis4 as the forward starts
    LABEL="S4-recipient-follower"
    ARM_MARKER="spawned pipelined forwarder"; ARM_COUNT=1
    TARGET_HOST="redis4"; PIDFILE="/tmp/redis_redis4_sg4.pid"
    ;;
  S6)  # recipient HOST crash: all three instances on redis3 die together, mid-transfer.
    # One fault, three roles: pair A loses its recipient LEADER (sg4), pairs B and C
    # each lose a chain FOLLOWER (sg5, sg6). Every recipient group keeps 2 of 3.
    LABEL="S6-recipient-host"
    ARM_MARKER="DONE-SLOTS-CHUNK"; ARM_COUNT=4
    TARGET_HOST="redis3"; PIDFILE="/tmp/redis_redis3_sg4.pid"
    PIDFILE_EXTRA="/tmp/redis_redis3_sg5.pid /tmp/redis_redis3_sg6.pid"
    ;;
  S7)  # donor HOST crash: all three instances on redis0 die together while sg1 transfers.
    # Pair A loses its donor LEADER (sg1), pairs B and C each lose a donor FOLLOWER
    # (sg2, sg3). redis0 is also the control node; only its redis-servers are killed.
    LABEL="S7-donor-host"
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="state=TRANSFER"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid"
    PIDFILE_EXTRA="/tmp/redis_redis0_sg2.pid /tmp/redis_redis0_sg3.pid"
    ;;
  S5)  # (was S8 until 2026-10-05; the old S5, removed 2026-10-04, is gone)
       # DOUBLE crash in ONE pair: donor leader (sg1) and recipient leader (sg4) together
    LABEL="S5-donor-leader+recipient-leader"
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="state=TRANSFER"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid"
    TARGET_HOST2="redis3"; PIDFILE2="/tmp/redis_redis3_sg4.pid"
    ;;
  S9)  # DOUBLE crash ACROSS pairs: donor leader of A (sg1) and recipient leader of B
    # (sg5 on redis4) together. Each pair must recover by itself, and pair C must
    # not notice. (With SCALEOUT_MODE=sequential pair B has not started yet: its
    # migration must then start against sg5's new leader.)
    LABEL="S9-donorA-leader+recipientB-leader"
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="state=TRANSFER"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid"
    TARGET_HOST2="redis4"; PIDFILE2="/tmp/redis_redis4_sg5.pid"
    ;;
  *)
    echo "scenarios.env (scaleout 3to6): unknown SCENARIO='$SCENARIO' (expected S1..S9, C1..C16)" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
