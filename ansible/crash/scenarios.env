# ---------------------------------------------------------------------------
# scenarios.env — per-scenario fault-injection config for the AqRaft crash
# tests. Sourced by run_crash_scenario.sh with $SCENARIO set to S1..S4.
# Sets: LABEL ARM_HOST ARM_LOG ARM_MARKER ARM_COUNT TARGET_HOST PIDFILE
#
# Topology (group_vars/all.yml):
#   donors  sg1 leader redis0:8000 (followers redis1,redis2)
#           sg2 leader redis1:8001 / sg3 leader redis2:8002
#   recipient sg4 leader redis3:8000 (chain followers redis4,redis5)
#
# ALL scenarios arm off the recipient leader log (redis3_sg4.log): it logs
# every DONE-SLOTS-CHUNK (all 12, 4/donor) and the leader-side chain markers
# (forward FIRST-POST). We fire on the Nth occurrence (grep -m<ARM_COUNT>)
# rather than a per-session seq= regex (seq is per-donor-session 0..3).
# ---------------------------------------------------------------------------
ARM_HOST="redis3"
ARM_LOG="/tmp/redis_logs/redis3_sg4.log"

case "$SCENARIO" in
  S1)  # recipient LEADER crash — kill redis3 mid-transfer (6th of 12 chunks)
    LABEL="S1-recipient-leader"
    ARM_MARKER="DONE-SLOTS-CHUNK"; ARM_COUNT=6
    TARGET_HOST="redis3"; PIDFILE="/tmp/redis_redis3_sg4.pid"
    ;;
  S2)  # donor LEADER crash — kill sg1 leader redis0 while it is transferring
    LABEL="S2-donor-leader"
    # Arm on redis0's OWN sg1 migration entering TRANSFER: guarantees sg1's TXN_START
    # is committed+applied on the followers (so a promoted leader sees the in-flight
    # session) but TXN_DONE has not fired. (The recipient DONE-SLOTS-CHUNK x1 marker
    # was racy: it fired on another donor's chunk, before sg1's TXN_START committed.)
    ARM_HOST="redis0"; ARM_LOG="/tmp/redis_logs/redis0_sg1.log"
    ARM_MARKER="state=TRANSFER"; ARM_COUNT=1
    TARGET_HOST="redis0"; PIDFILE="/tmp/redis_redis0_sg1.pid"
    ;;
  S3)  # donor FOLLOWER crash — kill sg1 follower on redis1 (majority holds)
    LABEL="S3-donor-follower"
    ARM_MARKER="DONE-SLOTS-CHUNK"; ARM_COUNT=1  # was 3: killed redis0 AFTER sg1 TXN_DONE (foundation had nothing in-flight); 1 = kill sg1 mid-transfer
    TARGET_HOST="redis1"; PIDFILE="/tmp/redis_redis1_sg1.pid"
    ;;
  S4)  # recipient FOLLOWER crash — kill chain follower redis4 right AFTER the
    # chain is FULLY established (both peers populated) and the leader's landing
    # buffers are registered, i.e. just as the forward is about to post to redis4.
    # "leader landing F1-PD twins ensured" is logged by EnsureSrcPool, which runs
    # after rdmaLeaderChainEstablish completes BOTH followers — so redis5's peer
    # entry is valid (no NULL-promote crash) and redis4 is alive at establish but
    # dies as the forward reaches it -> forward fails -> leader re-forms to redis5.
    # (Earlier markers: "chain established" matched a warm session and killed
    # before sess=1 established; "forward FIRST-POST" often landed after the fast
    # forward already completed.)
    LABEL="S4-recipient-follower"
    ARM_MARKER="spawned pipelined forwarder"; ARM_COUNT=1  # was "landing F1-PD twins ensured" — that fired for warm sess=9e17, killing redis4 ~10s before the real forward (S4 run 2310 FAILED)
    TARGET_HOST="redis4"; PIDFILE="/tmp/redis_redis4_sg4.pid"
    ;;
  *)
    echo "scenarios.env: unknown SCENARIO='$SCENARIO' (expected S1|S2|S3|S4)" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac
