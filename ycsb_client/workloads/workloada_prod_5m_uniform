# AqRaft production-scale workloada variant — 5M records, UNIFORM dist.
# - 5,000,000 records (~305 keys/slot; was 61 at 1M)
# - maxexecutiontime=300 so the run continues well past the migration window.
# - 30M operations cap (well above what 300s reaches).
# - 50/50 read/update uniform (writes hit every slot evenly so every migrating group backpatches), same mix as workloada.

recordcount=5000000
operationcount=30000000
maxexecutiontime=300
workload=site.ycsb.workloads.CoreWorkload

readallfields=true

readproportion=0.5
updateproportion=0.5
scanproportion=0
insertproportion=0

requestdistribution=uniform
